@model IEnumerable<BibliotecaMVC.Models.Autor>

@{
    ViewData["Title"] = "Autores";
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <span class="badge bg-primary mb-2">
                Biblioteca Virtual
            </span>

            <h1 class="fw-bold mb-1">
                Autores
            </h1>

            <p class="text-muted mb-0">
                Consulta la información de los autores registrados en BibliotecaMVC.
            </p>
        </div>

    </div>


    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th class="px-4 py-3">
                            ID
                        </th>

                        <th class="py-3">
                            Nombre
                        </th>

                        <th class="py-3">
                            Apellido
                        </th>

                        <th class="py-3">
                            Nacionalidad
                        </th>

                        <th class="py-3">
                            Fecha de nacimiento
                        </th>

                        <th class="py-3">
                            Estado
                        </th>

                        <th class="text-center py-3">
                            Acciones
                        </th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var autor in Model)
                    {
                        <tr>

                            <td class="px-4">
                                @autor.ID
                            </td>

                            <td class="fw-semibold">
                                @autor.Nombre
                            </td>

                            <td>
                                @autor.Apellido
                            </td>

                            <td>
                                @autor.Nacionalidad
                            </td>

                            <td>
                                @autor.FechaNacimiento.ToString("dd/MM/yyyy")
                            </td>

                            <td>

                                @if (autor.Activo)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Inactivo
                                    </span>
                                }

                            </td>


                            <td>

                                <div class="d-flex flex-wrap justify-content-center gap-2">

                                    <a asp-controller="Autores"
                                       asp-action="Details"
                                       asp-route-id="@autor.ID"
                                       class="btn btn-outline-info btn-sm">

                                        Detalles

                                    </a>

                                    <a asp-controller="Autores"
                                       asp-action="Edit"
                                       asp-route-id="@autor.ID"
                                       class="btn btn-outline-primary btn-sm">

                                        Editar

                                    </a>

                                    <a asp-controller="Autores"
                                       asp-action="Delete"
                                       asp-route-id="@autor.ID"
                                       class="btn btn-outline-danger btn-sm">

                                        Eliminar

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>