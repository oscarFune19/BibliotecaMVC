@model BibliotecaMVC.Models.Categoria

@{
    ViewData["Title"] = "Editar Categoría";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-primary text-white p-4">

                    <h2 class="mb-1">
                        Editar Categoría
                    </h2>

                    <p class="mb-0">
                        Modifica la información de la categoría seleccionada.
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Categorias"
                          asp-action="Edit"
                          method="post">

                        <input asp-for="ID"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                ID
                            </label>

                            <input value="@Model.ID"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="mb-4">

                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                                Nombre
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Descripcion"
                                   class="form-label fw-semibold">
                                Descripción
                            </label>

                            <textarea asp-for="Descripcion"
                                      class="form-control"
                                      rows="4">
                            </textarea>

                            <span asp-validation-for="Descripcion"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar cambios
                            </button>

                            <a asp-controller="Categorias"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>