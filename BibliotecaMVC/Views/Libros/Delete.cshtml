@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Eliminar Libro";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">

                <div class="card-header bg-danger text-white py-3">

                    <h2 class="h4 mb-0 fw-bold">
                        Eliminar libro
                    </h2>

                </div>

                <div class="card-body p-4">

                    <div class="alert alert-warning">
                        <strong>Atención:</strong>
                        ¿Está seguro de que desea eliminar este libro?
                    </div>

                    <div class="text-center mb-4">

                        <img src="@Model.Imagen"
                             alt="@Model.Titulo"
                             class="img-fluid rounded"
                             style="max-height: 250px; object-fit: cover;" />

                    </div>

                    <div class="mb-4">

                        <h3 class="fw-bold">
                            @Model.Titulo
                        </h3>

                        <p class="mb-2">
                            <strong>Autor:</strong>
                            @Model.Autor
                        </p>

                        <p class="mb-2">
                            <strong>Categoría:</strong>
                            @Model.Categoria
                        </p>

                        <p class="mb-2">
                            <strong>Año de publicación:</strong>
                            @Model.AnioPublicacion
                        </p>

                        <p class="mb-0">
                            <strong>Estado:</strong>

                            @if (Model.Disponible)
                            {
                                <span class="badge bg-success">
                                    Disponible
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    No disponible
                                </span>
                            }
                        </p>

                    </div>

                    <form asp-controller="Libros"
                          asp-action="Delete"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@Model.ID" />

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('¿Está seguro de que desea eliminar este libro?');">
                                Sí, eliminar
                            </button>

                            <a asp-controller="Libros"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>