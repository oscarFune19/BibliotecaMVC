@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Detalle del Libro";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-sm">

                <div class="row g-0">

                    <div class="col-md-4">

                        <img src="@Model.Imagen"
                             class="img-fluid rounded-start w-100"
                             alt="@Model.Titulo"
                             style="height: 100%; object-fit: cover;" />

                    </div>

                    <div class="col-md-8">

                        <div class="card-body">

                            <h2 class="card-title">
                                @Model.Titulo
                            </h2>

                            <hr />

                            <p>
                                <strong>ID:</strong>
                                @Model.ID
                            </p>

                            <p>
                                <strong>Autor:</strong>
                                @Model.Autor
                            </p>

                            <p>
                                <strong>Categoría:</strong>
                                @Model.Categoria
                            </p>

                            <p>
                                <strong>Año de publicación:</strong>
                                @Model.AnioPublicacion
                            </p>

                            <p>
                                <strong>Estado:</strong>

                                @if (Model.Disponible)
                                {
                                    <span class="badge bg-success">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        No disponible
                                    </span>
                                }

                            </p>

                            <a asp-controller="Libros"
                               asp-action="Edit"
                               asp-route-id="@Model.ID"
                               class="btn btn-warning">
                                Editar
                            </a>

                            <a asp-controller="Libros"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Regresar
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>