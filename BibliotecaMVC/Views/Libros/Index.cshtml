@model IEnumerable<BibliotecaMVC.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="container py-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <span class="badge bg-primary mb-2">
                Biblioteca Virtual
            </span>

            <h1 class="fw-bold mb-1">
                Libros
            </h1>

            <p class="text-muted mb-0">
                Consulta y administra los libros registrados en BibliotecaMVC.
            </p>
        </div>

        <a asp-controller="Libros"
           asp-action="Create"
           class="btn btn-primary">
            + Agregar libro
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info shadow-sm">
            No hay libros registrados todavía.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

            @foreach (var libro in Model)
            {
                <div class="col">

                    <div class="card h-100 shadow-sm border-0 rounded-4 overflow-hidden">

                        <img src="@libro.Imagen"
                             class="card-img-top"
                             alt="@libro.Titulo"
                             style="height: 240px; object-fit: cover;" />

                        <div class="card-body d-flex flex-column">

                            <div class="mb-2">
                                <span class="badge bg-primary">
                                    @libro.Categoria
                                </span>
                            </div>

                            <h4 class="card-title fw-bold">
                                @libro.Titulo
                            </h4>

                            <p class="text-muted mb-2">
                                <strong>Autor:</strong> @libro.Autor
                            </p>

                            <p class="text-muted mb-3">
                                <strong>Año:</strong> @libro.AnioPublicacion
                            </p>

                            <div class="mb-3">

                                @if (libro.Disponible)
                                {
                                    <span class="badge bg-success">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        No disponible
                                    </span>
                                }

                            </div>

                            <div class="mt-auto d-flex gap-2">

                                <a asp-controller="Libros"
                                   asp-action="Details"
                                   asp-route-id="@libro.ID"
                                   class="btn btn-outline-primary btn-sm flex-fill">
                                    Ver
                                </a>

                                <a asp-controller="Libros"
                                   asp-action="Edit"
                                   asp-route-id="@libro.ID"
                                   class="btn btn-warning btn-sm flex-fill">
                                    Editar
                                </a>

                                <a asp-controller="Libros"
                                   asp-action="Delete"
                                   asp-route-id="@libro.ID"
                                   class="btn btn-danger btn-sm flex-fill">
                                    Eliminar
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>