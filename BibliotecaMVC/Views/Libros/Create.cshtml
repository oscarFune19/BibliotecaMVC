@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Agregar Libro";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-header bg-primary text-white p-4">

                    <h2 class="mb-1">
                        Agregar Libro
                    </h2>

                    <p class="mb-0">
                        Registra un nuevo libro en BibliotecaMVC.
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-controller="Libros"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <div class="mb-3">

                            <label asp-for="Titulo"
                                   class="form-label fw-semibold">
                                Título
                            </label>

                            <input asp-for="Titulo"
                                   class="form-control"
                                   placeholder="Ingrese el título del libro" />

                            <span asp-validation-for="Titulo"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Autor"
                                   class="form-label fw-semibold">
                                Autor
                            </label>

                            <input asp-for="Autor"
                                   class="form-control"
                                   placeholder="Ingrese el autor" />

                            <span asp-validation-for="Autor"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Categoria"
                                   class="form-label fw-semibold">
                                Categoría
                            </label>

                            <input asp-for="Categoria"
                                   class="form-control"
                                   placeholder="Ejemplo: Novela" />

                            <span asp-validation-for="Categoria"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="AnioPublicacion"
                                   class="form-label fw-semibold">
                                Año de publicación
                            </label>

                            <input asp-for="AnioPublicacion"
                                   class="form-control"
                                   type="number" />

                            <span asp-validation-for="AnioPublicacion"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Imagen"
                                   class="form-label fw-semibold">
                                Ruta de imagen
                            </label>

                            <input asp-for="Imagen"
                                   class="form-control"
                                   placeholder="/images/libro-default.jpg" />

                        </div>


                        <div class="form-check mb-4">

                            <input asp-for="Disponible"
                                   class="form-check-input" />

                            <label asp-for="Disponible"
                                   class="form-check-label">
                                Disponible
                            </label>

                        </div>


                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar libro
                            </button>

                            <a asp-controller="Libros"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}