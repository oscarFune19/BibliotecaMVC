@model BibliotecaMVC.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-warning">

                    <h2 class="h4 mb-0">
                        Editar libro
                    </h2>

                </div>

                <div class="card-body">

                    <form asp-controller="Libros"
                          asp-action="Edit"
                          method="post">

                        <input type="hidden"
                               asp-for="ID" />

                        <div class="mb-3">

                            <label asp-for="Titulo"
                                   class="form-label">
                                Título
                            </label>

                            <input asp-for="Titulo"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Autor"
                                   class="form-label">
                                Autor
                            </label>

                            <input asp-for="Autor"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Categoria"
                                   class="form-label">
                                Categoría
                            </label>

                            <input asp-for="Categoria"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label asp-for="AnioPublicacion"
                                   class="form-label">
                                Año de publicación
                            </label>

                            <input asp-for="AnioPublicacion"
                                   type="number"
                                   class="form-control"
                                   required />

                        </div>

                        <div class="mb-3">

                            <label asp-for="Imagen"
                                   class="form-label">
                                Ruta de imagen
                            </label>

                            <input asp-for="Imagen"
                                   class="form-control" />

                        </div>

                        <div class="form-check mb-4">

                            <input asp-for="Disponible"
                                   class="form-check-input" />

                            <label asp-for="Disponible"
                                   class="form-check-label">
                                Libro disponible
                            </label>

                        </div>

                        <button type="submit"
                                class="btn btn-success">
                            Guardar cambios
                        </button>

                        <a asp-controller="Libros"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>