@model BibliotecaMVC.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Iniciar sesión</h2>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UsuarioOCorreo" class="form-label">
                                Usuario o correo electrónico
                            </label>
                            <input asp-for="UsuarioOCorreo" class="form-control" />
                            <span asp-validation-for="UsuarioOCorreo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">
                                Contraseña
                            </label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Recordarme" class="form-check-input" />
                            <label asp-for="Recordarme" class="form-check-label">
                                Recordarme
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Iniciar sesión
                        </button>
                    </form>

                    <div class="text-center mt-3">
                        <span>¿No tienes una cuenta?</span>
                        <a asp-controller="Account" asp-action="Register">
                            Registrarse
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}