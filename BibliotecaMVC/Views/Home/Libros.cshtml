        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3">
            <h3>El principito</h3>
            <p>Antoine de Saint-Exupéry</p>
            <span class="badge bg-success">Disponible</span>
        </div>
    </div>
</div>