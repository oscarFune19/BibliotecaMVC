@{
    ViewData["Title"] = "Libros";
}

<h1>Libros</h1>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card p-3">
            <h3>Cien años de soledad</h3>
            <p>Gabriel García Márquez</p>
            <span class="badge bg-success">Disponible</span>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card p-3">
            <h3>1984</h3>
            <p>George Orwell</p>
