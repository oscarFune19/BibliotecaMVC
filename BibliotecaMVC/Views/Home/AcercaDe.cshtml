@{
    ViewData["Title"] = "Acerca de";

    var servicios = new List<BibliotecaMVC.Models.InfoCardViewModel>
    {
        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "📖",
            Titulo = "Catálogo de libros",
            Descripcion = "Consulta títulos, autores, categorías, disponibilidad e información detallada."
        },

        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "✍️",
            Titulo = "Gestión de autores",
            Descripcion = "Permite visualizar y administrar información relacionada con los autores registrados."
        },

        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "🗂️",
            Titulo = "Categorías",
            Descripcion = "Facilita la organización de libros de acuerdo con diferentes géneros y temáticas."
        },

        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "📋",
            Titulo = "Préstamos",
            Descripcion = "Permite consultar información relacionada con los préstamos realizados."
        }
    };

    var caracteristicas = new List<BibliotecaMVC.Models.InfoCardViewModel>
    {
        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "📱",
            Titulo = "Diseño adaptable",
            Descripcion = "La interfaz se adapta correctamente a computadoras, tablets y teléfonos móviles."
        },

        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "⚡",
            Titulo = "Acceso rápido",
            Descripcion = "La navegación permite acceder fácilmente a libros, autores, categorías y préstamos."
        },

        new BibliotecaMVC.Models.InfoCardViewModel
        {
            Icono = "🎨",
            Titulo = "Interfaz organizada",
            Descripcion = "Los contenidos utilizan una estructura visual limpia, consistente y fácil de comprender."
        }
    };
}

<div class="about-page">

    <!-- ENCABEZADO -->
    <header class="about-header">

        <span class="about-label">
            Biblioteca Virtual
        </span>

        <h1>
            Acerca de BibliotecaMVC
        </h1>

        <p>
            Un sistema diseñado para facilitar el acceso,
            organización y consulta de recursos bibliográficos.
        </p>

    </header>


    <!-- INFORMACIÓN PRINCIPAL -->
    <section class="about-section">

        <article class="about-article">

            <h2>
                Nuestra biblioteca
            </h2>

            <p>
                BibliotecaMVC es una plataforma virtual orientada
                a la gestión y consulta de información relacionada
                con libros, autores, categorías y servicios
                bibliotecarios.
            </p>

            <p>
                El sistema permite organizar el catálogo y
                ofrecer a los usuarios una forma sencilla de
                consultar los recursos disponibles dentro de
                la biblioteca.
            </p>

        </article>


        <aside class="about-aside">

            <h3>
                📚 Nuestro objetivo
            </h3>

            <p>
                Facilitar el acceso al conocimiento mediante
                herramientas digitales que permitan encontrar
                información bibliográfica de manera rápida y
                organizada.
            </p>

        </aside>

    </section>


    <!-- COMPONENTE REUTILIZABLE 1 -->
    <section class="about-services">

        <header>

            <span class="about-label">
                Nuestros recursos
            </span>

            <h2>
                Servicios disponibles
            </h2>

            <p>
                BibliotecaMVC integra diferentes herramientas
                para la administración de una biblioteca virtual.
            </p>

        </header>


        <div class="about-services-grid">

            @foreach (var servicio in servicios)
            {
                <partial name="_ServiceCard"
                         model="servicio" />
            }

        </div>

    </section>


    <!-- COMPONENTE REUTILIZABLE 2 -->
    <section class="about-features">

        <header class="text-center">

            <span class="about-label">
                Experiencia digital
            </span>

            <h2>
                Una biblioteca pensada para todos
            </h2>

            <p>
                La plataforma combina organización, accesibilidad
                y una experiencia adaptable a diferentes dispositivos.
            </p>

        </header>


        <div class="about-features-grid">

            @foreach (var caracteristica in caracteristicas)
            {
                <partial name="_FeatureCard"
                         model="caracteristica" />
            }

        </div>

    </section>


    <!-- INFORMACIÓN DEL PROYECTO -->
    <section class="about-project">

        <article>

            <h2>
                Tecnología utilizada
            </h2>

            <p>
                El sistema BibliotecaMVC está desarrollado
                utilizando ASP.NET Core MVC y .NET 10.
            </p>

            <ul>
                <li>HTML5 semántico</li>
                <li>CSS3</li>
                <li>Bootstrap</li>
                <li>Razor</li>
                <li>ASP.NET Core MVC</li>
                <li>CSS Flexbox</li>
                <li>CSS Grid</li>
                <li>Diseño responsivo</li>
                <li>Partial Views reutilizables</li>
            </ul>

        </article>

    </section>

</div>