@{
    ViewData["Title"] = "Acerca de";
}

<div class="about-page">

    <!-- ENCABEZADO SEMÁNTICO -->
    <header class="about-header">

        <span class="about-label">
            Biblioteca Virtual
        </span>

        <h1>
            Acerca de BibliotecaMVC
        </h1>

        <p>
            Un sistema diseñado para facilitar el acceso,
            organización y consulta de recursos bibliográficos.
        </p>

    </header>


    <!-- SECCIÓN PRINCIPAL -->
    <section class="about-section">

        <article class="about-article">

            <h2>
                Nuestra biblioteca
            </h2>

            <p>
                BibliotecaMVC es una plataforma virtual orientada
                a la gestión y consulta de información relacionada
                con libros, autores, categorías y servicios
                bibliotecarios.
            </p>

            <p>
                El sistema permite organizar el catálogo y
                ofrecer a los usuarios una forma sencilla de
                consultar los recursos disponibles dentro de
                la biblioteca.
            </p>

        </article>


        <aside class="about-aside">

            <h3>
                📚 Nuestro objetivo
            </h3>

            <p>
                Facilitar el acceso al conocimiento mediante
                herramientas digitales que permitan encontrar
                información bibliográfica de manera rápida y
                organizada.
            </p>

        </aside>

    </section>


    <!-- SERVICIOS -->
    <section class="about-services">

        <header>

            <h2>
                Servicios disponibles
            </h2>

            <p>
                BibliotecaMVC integra diferentes herramientas
                para la administración de una biblioteca virtual.
            </p>

        </header>


        <div class="about-services-grid">


            <article class="about-service">

                <span>
                    📖
                </span>

                <h3>
                    Catálogo de libros
                </h3>

                <p>
                    Consulta títulos, autores, categorías,
                    disponibilidad e información detallada.
                </p>

            </article>


            <article class="about-service">

                <span>
                    ✍️
                </span>

                <h3>
                    Gestión de autores
                </h3>

                <p>
                    Permite visualizar y administrar información
                    relacionada con los autores registrados.
                </p>

            </article>


            <article class="about-service">

                <span>
                    🗂️
                </span>

                <h3>
                    Categorías
                </h3>

                <p>
                    Facilita la organización de libros de acuerdo
                    con diferentes géneros y temáticas.
                </p>

            </article>


            <article class="about-service">

                <span>
                    📋
                </span>

                <h3>
                    Préstamos
                </h3>

                <p>
                    Permite consultar información relacionada
                    con los préstamos realizados.
                </p>

            </article>

        </div>

    </section>


    <!-- INFORMACIÓN DEL PROYECTO -->
    <section class="about-project">

        <article>

            <h2>
                Tecnología utilizada
            </h2>

            <p>
                El sistema BibliotecaMVC está desarrollado
                utilizando ASP.NET Core MVC y .NET 10.
            </p>

            <ul>
                <li>HTML5 semántico</li>
                <li>CSS3</li>
                <li>Bootstrap</li>
                <li>Razor</li>
                <li>ASP.NET Core MVC</li>
                <li>Diseño responsivo</li>
            </ul>

        </article>

    </section>

</div>