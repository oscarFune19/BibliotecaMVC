@model BibliotecaMVC.Models.ErrorViewModel

@{
    ViewData["Title"] = "Ocurrió un problema";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mx-auto mb-4 d-flex align-items-center justify-content-center rounded-circle bg-danger-subtle text-danger"
                         style="width: 86px; height: 86px; font-size: 42px; font-weight: 700;">
                        !
                    </div>

                    <span class="badge bg-danger-subtle text-danger mb-3">
                        BibliotecaMVC
                    </span>

                    <h1 class="fw-bold mb-3">
                        Ocurrió un problema inesperado
                    </h1>

                    <p class="text-muted fs-5 mb-4">
                        No pudimos completar la operación en este momento.
                        Puedes regresar al inicio o continuar navegando por una sección disponible.
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary px-4">
                            Volver al inicio
                        </a>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Libros"
                               asp-action="Index"
                               class="btn btn-outline-primary px-4">
                                Ir a Libros
                            </a>
                        }

                        <a asp-controller="Categorias"
                           asp-action="Index"
                           class="btn btn-outline-secondary px-4">
                            Ir a Categorías
                        </a>
                    </div>

                    <p class="small text-muted mt-4 mb-0">
                        Si el problema continúa, intenta nuevamente más tarde.
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
